# Ash Assistant API first-run environment template
# Copy this file to .env in the same folder and adjust values as needed.

APP_NAME=Ash Assistant
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Wake word
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.60
WAKE_WORD_TIMEOUT_SECONDS=20

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
# Set these after calling GET /api/v1/voice/devices
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
UTTERANCE_RECORD_SECONDS=6

# STT
VOICE_STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
CONVERSATION_LANGUAGE=en

# TTS (optional; if empty, fallback uses Windows SAPI)
PIPER_VOICE_MODEL_PATH=
PIPER_VOICE_CONFIG_PATH=
PIPER_USE_CUDA=false

# Conversation and memory
SESSION_MEMORY_LIMIT=8
CONVERSATION_TEMPERATURE=0.7
